# Copy this file to .env and fill in your real values.
# Do not share .env because it contains account credentials.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional. If blank, the script asks for Garmin credentials at runtime.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Strava app callback domain should be localhost.
STRAVA_CALLBACK_URL=http://localhost
LYFTA_CSV=WorkoutData.csv

# How many days of Strava activities to scan.
DAYS_BACK=30

# Optional calorie estimate fallback.
# If USER_WEIGHT_KG is blank, the app tries Garmin profile weight, then 85 kg.
USER_WEIGHT_KG=
STRENGTH_MET=5.0
SYNC_MODE=direct

# Lyfta API key for auto-fetching workouts (generate at https://my.lyfta.app/community/api)
LYFTA_API_KEY=
# How far back to fetch Lyfta workouts before each sync.
LYFTA_API_DAYS_BACK=3650

# Windows Task Scheduler daily run time.
DAILY_SYNC_TIME=08:00
DAILY_REPORT_TIME=08:10
